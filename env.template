# Your API token from Fastmail for scanning emails.
# Example: FASTMAIL_API_TOKEN=ms1234567890abcdef1234567890
FASTMAIL_API_TOKEN=

# The address of your ProjectZeus instance.
# This must be accessible from the backend container. The syntax is http://<host>:<port>
#
# - If ProjectZeus runs on your host machine, use http://host.docker.internal:<port>
# - If ProjectZeus runs on another machine on your network, use its IP address.
#
# If you see connection errors in the logs, verify that this address is correct
# and reachable from within the backend's Docker container.
#
# Example: PROJECTZEUS_ADDRESS=http://host.docker.internal:8080
# Example: PROJECTZEUS_ADDRESS=http://192.168.1.100:8080
PROJECTZEUS_ADDRESS=http://host.docker.internal:8080

# Optionally, specify a project name from ProjectZeus to ignore during discovery.
# Example: PROJECTZEUS_IGNORE_LABEL=wetransfer
PROJECTZEUS_IGNORE_LABEL=wetransfer

# Host and port for the backend, for the frontend to connect to.
# This is used by the frontend JavaScript running in your browser.
# If left blank, it defaults to the current page's hostname with port 2155.
# This is usually what you want for local development.
# Example: VITE_BACKEND_HOST=192.168.1.100:2155
VITE_BACKEND_HOST=
